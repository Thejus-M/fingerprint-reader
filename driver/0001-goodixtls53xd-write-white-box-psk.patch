+static void check_preset_psk_write(FpDevice* dev, guint8* data,
+                                  guint16 length, gpointer user_data,
+                                  GError* error)
+{
+    FpiDeviceGoodixTls53XD* self = FPI_DEVICE_GOODIXTLS53XD(dev);
+
+    if (error) {
+        fpi_ssm_mark_failed(user_data, error);
+        return;
+    }
+
+    if (length < sizeof(guint8) || data[0] != 0x00) {
+        g_set_error(&error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                    "Device rejected the PSK write (reply 0x%02x)",
+                    length < sizeof(guint8) ? 0xff : data[0]);
+        fpi_ssm_mark_failed(user_data, error);
+        return;
+    }
+
+    self->psk_write_attempted = TRUE;
+
+    // Read the PSK back: only the device's own hash of it decides whether the
+    // pairing is now the one this driver can speak.
+    fpi_ssm_jump_to_state(user_data, OPEN_CHECK_PSK);
+}
+
+// Builds the preset-PSK write frame the 53xd expects, which
+// goodix_send_preset_psk_write() does not produce: a total/length/offset
+// header, then the pre-flags, the write flags, the blob length and the blob.
+static guint8* psk_write_payload(guint16* out_length)
+{
+    const guint16 body_length = sizeof(goodix_53xd_psk_write_pre_flags) +
+                                2 * sizeof(guint32) +
+                                sizeof(goodix_53xd_psk_white_box);
+    const guint16 payload_length = 3 * sizeof(guint32) + body_length;
+    guint8* payload = g_malloc0(payload_length);
+    guint8* p = payload;
+    guint32 v;
+
+    v = GUINT32_TO_LE(body_length);
+    memcpy(p, &v, sizeof(v));
+    p += sizeof(v);
+    v = GUINT32_TO_LE(body_length);
+    memcpy(p, &v, sizeof(v));
+    p += sizeof(v);
+    v = GUINT32_TO_LE(0);
+    memcpy(p, &v, sizeof(v));
+    p += sizeof(v);
+
+    memcpy(p, goodix_53xd_psk_write_pre_flags,
+           sizeof(goodix_53xd_psk_write_pre_flags));
+    p += sizeof(goodix_53xd_psk_write_pre_flags);
+
+    v = GUINT32_TO_LE(GOODIX_53XD_PSK_WRITE_FLAGS);
+    memcpy(p, &v, sizeof(v));
+    p += sizeof(v);
+    v = GUINT32_TO_LE(sizeof(goodix_53xd_psk_white_box));
+    memcpy(p, &v, sizeof(v));
+    p += sizeof(v);
+
+    memcpy(p, goodix_53xd_psk_white_box, sizeof(goodix_53xd_psk_white_box));
+
+    *out_length = payload_length;
+    return payload;
+}
+
 static void open_run_state(FpiSsm* ssm, FpDevice* dev)
 {
     switch (fpi_ssm_get_cur_state(ssm)) {
@@ -374,6 +462,22 @@ static void open_run_state(FpiSsm* ssm, FpDevice* dev)
                                     check_preset_psk_read, ssm);
         break;
 
+    case OPEN_WRITE_PSK: {
+        guint16 payload_length;
+        guint8* payload;
+
+        if (FPI_DEVICE_GOODIXTLS53XD(dev)->psk_ok) {
+            fpi_ssm_next_state(ssm);
+            break;
+        }
+
+        payload = psk_write_payload(&payload_length);
+        goodix_send_protocol(dev, GOODIX_CMD_PRESET_PSK_WRITE, payload,
+                             payload_length, g_free, TRUE, GOODIX_TIMEOUT, TRUE,
+                             check_preset_psk_write, ssm);
+        break;
+    }
+
     case OPEN_RESET:
         goodix_send_reset(dev, TRUE, 20, check_reset, ssm);
         break;
